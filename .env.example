# Environment variables read by server/config.js. Set them in your shell, in the
# hosting dashboard (Render), or copy this file to .env (git-ignored): the server
# reads .env at start-up, and a variable already set in the shell wins over it.
# All are optional for the local demo.

# HTTP port for the API, Socket.IO and the built React app
PORT=4000

# Behind a hosting proxy (Render, Nginx) set to the number of proxy hops, usually 1,
# so rate limits and the webhook allow-list see the caller's real address.
TRUST_PROXY=

# Leave empty to use the embedded PostgreSQL (PGlite) stored in .data/pgdata.
# Set to a Supabase / Render PostgreSQL connection string for hosting.
# The database needs the btree_gist extension (Supabase and Render have it).
DATABASE_URL=

# Secret used to sign login tokens. Always set this outside local development:
# with NODE_ENV=production the server refuses to start without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a sign-in lasts (e.g. 12h, 7d, 30d). A password change or suspension
# still signs the account out at once.
JWT_EXPIRES_IN=7d

# GPS trackers fitted in the buses (docs/GPS_TRACKERS.md). Raw TCP listeners
# stay off unless a port is set: GT06 for Concox / GT06-family units, Teltonika
# for FMB/FMC. Open the ports in the firewall; Render cannot accept raw TCP.
GPS_GT06_PORT=
GPS_TELTONIKA_PORT=
# Secret for positions forwarded by a Traccar server or a vendor platform
# (POST /api/gps/webhook). Empty = webhook off.
GPS_WEBHOOK_SECRET=
# Trips start and end by themselves from tracker movement (0 = drivers only).
GPS_AUTO_TRIPS=1
# Hours in which movement starts a trip; empty = TRAVEL_WINDOWS.
GPS_TRIP_WINDOWS=

# Performance (optional). Password-hashing threads (default: CPU cores - 1, max 8)
# and PostgreSQL connections (default 20; keep below your database plan's limit).
BCRYPT_WORKERS=
PG_POOL_MAX=

# Password given to every seeded account (admin, finance, drv101..., stu001-stu024) on first start.
DEMO_PASSWORD=Demo@2026
# Set to 0 to skip creating the 24 demo student accounts.
SEED_DEMO_STUDENTS=1

# ---- Payments (doc section 8) -----------------------------------------------
# Leave the three RAZORPAY_ values empty to use the built-in test gateway
# (same signed-webhook contract, no money moves). Use rzp_test_ keys first:
# "switching to live keys is the last step, not the first" (doc Phase 8).
#   Dashboard -> Account & Settings -> API Keys          : key id + key secret
#   Dashboard -> Account & Settings -> Webhooks -> Add    : URL https://<your-host>/api/webhooks/payment,
#       events payment.captured, payment.failed, refund.processed, and a secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: comma-separated addresses allowed to call the webhook (Razorpay publishes them).
WEBHOOK_ALLOWED_IPS=
# Name printed on receipts; the gateway account must be in the institution's name.
MERCHANT_NAME=BSACIST Transport Department

# Students use live tracking, alerts and attendance free. Set to 1 to require
# the paid monthly subscription again (the student apps then show the
# Subscription screen and paywalls).
STUDENT_SUBSCRIPTION_REQUIRED=0

# ---- Attendance (doc section 9) ---------------------------------------------
# Default travel windows, campus time, when student phones may sample location.
# Students can set their own in Settings. For a demo outside these hours use
# 00:00-24:00 (RUN-DEMO.bat does).
TRAVEL_WINDOWS=06:00-10:30,15:30-19:30
# "Did you board?" from the bus GPS: asked when the bus leaves a student's saved
# stop, and repeated every BOARDING_REMIND_MINUTES until they answer (0 = off).
BOARDING_CHECKS=1
BOARDING_REMIND_MINUTES=10

# Set to production to stop returning device-change codes in API responses.
NODE_ENV=

# ---- Maps -------------------------------------------------------------------
# Browser key for the Maps JavaScript API. Set it and the web app's maps use
# Google Maps; leave it empty for OpenStreetMap. Baked into the built page, so
# restrict it in Google Cloud to your site's address (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=
